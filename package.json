{
  "name": "lexical-tufte-workspace",
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm inventory:check && pnpm typecheck && pnpm build && pnpm test",
    "lint": "node scripts/lint.mjs",
    "inventory:check": "node scripts/inventory.mjs",
    "test": "pnpm -r --if-present test",
    "test:browser": "pnpm build && node tests/note-browser.mjs && node tests/note-editing-browser.mjs",
    "dev:editor": "pnpm --filter @lexical-tufte/lexical build && pnpm --filter @lexical-tufte/editor-prototype dev"
  },
  "devDependencies": {
    "playwright": "1.51.1"
  }
}
